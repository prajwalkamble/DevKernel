# PostHog analytics.
#
# Both variables are read in instrumentation-client.ts. Leave them unset and
# analytics never initialises, which is what a local checkout, CI and a fork
# should do — copy this file to .env.local and fill the key in only when you
# want your own browsing to show up in the project.
#
# NEXT_PUBLIC_ values are inlined into the client bundle by `next build`, not
# read at runtime, so these must be present in the environment that runs the
# production build rather than only on the server that serves it.

# Project API key, from PostHog under Settings -> Project -> Project API key.
# It is a write-only ingest key and is meant to ship to the browser; it is not
# a secret and does not grant read access to the project.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_with_your_project_api_key

# Ingest host for your PostHog region. Defaults to US cloud when unset.
#   US cloud: https://us.i.posthog.com
#   EU cloud: https://eu.i.posthog.com
# Self-hosted instances use their own origin.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
