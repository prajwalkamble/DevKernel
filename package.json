    "posthog-js": "^1.418.10",
    "pyodide": "^314.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
